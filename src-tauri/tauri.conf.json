{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Enframe",
	"version": "0.1.0",
	"identifier": "com.enframe.app",
	"build": {
		"beforeBuildCommand": "bun run sidecar && bun run sveltekit:build",
		"beforeDevCommand": "bun run sidecar && bun run sveltekit:dev",
		"devUrl": "http://localhost:5910",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Enframe",
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"width": 1400,
				"height": 900,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' asset: http://asset.localhost http: https: data:; style-src 'self' 'unsafe-inline'",
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"copyright": "",
		"shortDescription": "",
		"longDescription": "",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"resources": [],
		"externalBin": ["binaries/enframe-serve"],
		"linux": {
			"deb": {
				"depends": []
			}
		},
		"macOS": {
			"frameworks": [],
			"entitlements": null,
			"exceptionDomain": "",
			"providerShortName": null,
			"signingIdentity": null
		},
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		}
	}
}
