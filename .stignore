// secrets — backstop; per-project opt-in is the real boundary
!**/.env.example
!**/.env.sample
!**/*credentials*.rs
!**/*credentials*.ts
!**/*credentials*.py
!**/*credentials*.js
!**/*credentials*.svelte
(?d)**/.env
(?d)**/.env.*
(?d)**/.npmrc
(?d)**/*.pem
(?d)**/*.key
(?d)**/*.p12
(?d)**/*credentials*
(?d)**/secrets.*
(?d)**/.netrc
(?d)**/id_rsa*
(?d)**/id_ed25519*
(?d)**/service-account*.json
// vcs + build artifacts
(?d).git
(?d)*.DS_Store
(?d)**/node_modules
(?d)**/__pycache__
(?d)**/*.pyc
(?d)**/.venv
(?d)**/target
(?d)**/.wrangler
(?d)**/.svelte-kit
(?d)**/build
(?d)**/dist
(?d)**/.turbo
(?d)**/.cache
(?d)**/.pytest_cache
(?d)**/.ruff_cache
(?d)**/.mypy_cache
(?d)**/test-results
(?d)**/playwright-report
(?d)**/*.bin
(?d)**/*.pt
// bloat
(?d)**/.claude/worktrees
(?d)**/*.gguf
// live sqlite — the writer host owns it; no (?d), a remote dir delete must never take a live db
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite-journal
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*.sqlite3-journal
(?d)/scripts/lr_backup
