{
	"name": "enframe",
	"version": "0.1.0",
	"private": true,
	"description": "Image framing tool for setting focal points and crops with Lightroom integration",
	"type": "module",
	"packageManager": "bun@1.2.19",
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.2.0"
	},
	"keywords": [
		"sveltekit",
		"tauri",
		"rolldown",
		"tailwindcss",
		"shadcn",
		"bun",
		"desktop",
		"typescript",
		"biome"
	],
	"scripts": {
		"dev": "bun run tauri dev",
		"build": "bun run tauri build",
		"preview": "vite preview",
		"tauri": "tauri",
		"sidecar": "bash scripts/sidecar.sh",
		"sveltekit:dev": "vite dev",
		"sveltekit:build": "vite build",
		"build:web": "ENFRAME_TARGET=web vite build && node scripts/worker-manifest.mjs build-web",
		"deploy:web": "bun run build:web && wrangler deploy",
		"sveltekit:preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"type-check": "tsc --noEmit",
		"sync": "svelte-kit sync",
		"format": "biome format --write ./src",
		"format:check": "biome format ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"lint:unsafe": "biome lint --write --unsafe ./src",
		"code-quality": "bun run format && bun run lint:fix && bun run check",
		"clean": "rm -rf node_modules && rm -rf .svelte-kit && rm -rf src-tauri/gen && rm -rf src-tauri/target && rm -rf src-tauri/versoview",
		"reinstall": "bun run clean && bun install",
		"serve": "cargo run --release --manifest-path src-tauri/Cargo.toml -p enframe-serve --",
		"test": "vitest run",
		"test:watch": "vitest",
		"screenshots": "bash scripts/screenshots.sh"
	},
	"dependencies": {
		"@jsquash/avif": "^2.1.1",
		"@tailwindcss/vite": "^4.1.12",
		"@tauri-apps/plugin-dialog": "^2.6.0",
		"@tauri-apps/plugin-fs": "^2.4.5",
		"bits-ui": "^2.16.1",
		"clsx": "^2.1.1",
		"libraw-wasm": "^1.6.0",
		"runed": "^0.37.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^2.1.0",
		"tailwindcss": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.31.1",
		"@tauri-apps/cli": "^2.7.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.3.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.38.1",
		"svelte-check": "^4.3.1",
		"svelte-sonner": "^1.0.7",
		"tw-animate-css": "^1.3.7",
		"typescript": "^5.9.2",
		"vite": "npm:rolldown-vite@7.1.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@tauri-apps/api": ">=2.6.0"
	},
	"browserslist": [
		"defaults",
		"not IE 11"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/yourusername/enframe.git"
	},
	"bugs": {
		"url": "https://github.com/yourusername/enframe/issues"
	},
	"homepage": "https://github.com/yourusername/enframe#readme",
	"license": "MIT",
	"files": [
		"build",
		"src",
		"static",
		"svelte.config.js",
		"vite.config.ts",
		"tsconfig.json"
	]
}
